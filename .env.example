# ============================================================
# LeadFlow AI - API / Infrastructure
# Copy this file to .env and provide your own secrets.
# Never commit .env.
# ============================================================

APP_ENV=local

# ------------------------------------------------------------
# Database / Supabase
# ------------------------------------------------------------

DATABASE_URL=

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVER_KEY=

# ------------------------------------------------------------
# AI Qualification
# ------------------------------------------------------------

# Recommended for the local/demo environment.
# "mock" does not require OpenAI billing.
AI_PROVIDER=mock

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

AI_PROMPT_VERSION=lead-assessment-v1
AI_TIMEOUT_SECONDS=20

# ------------------------------------------------------------
# HubSpot CRM
# ------------------------------------------------------------

HUBSPOT_PROVIDER=hubspot
HUBSPOT_ACCESS_TOKEN=

HUBSPOT_API_BASE_URL=https://api.hubapi.com
HUBSPOT_API_VERSION=2026-03
HUBSPOT_TIMEOUT_SECONDS=15

HUBSPOT_DEAL_PIPELINE_ID=
HUBSPOT_DEAL_STAGE_ID=
# Routing
HUBSPOT_DEFAULT_OWNER_ID=
ROUTING_TIMEZONE=America/New_York
# ------------------------------------------------------------
# Communications
# ------------------------------------------------------------

# Use "mock" for a provider-free local demo.
COMMUNICATION_PROVIDER=mock
COMMUNICATION_TIMEOUT_SECONDS=15

RESEND_API_KEY=
RESEND_FROM_EMAIL=NorthStar Home Services <onboarding@resend.dev>

# ------------------------------------------------------------
# Slack
# ------------------------------------------------------------

SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=
SLACK_HOT_CHANNEL=leadflow-hot
SLACK_OWNER_USER_ID=

# ------------------------------------------------------------
# Booking / Cal.com
# ------------------------------------------------------------

BOOKING_PROVIDER=configured
BOOKING_BASE_URL=https://cal.com/northstar-demo/service

CAL_WEBHOOK_SECRET=

# ------------------------------------------------------------
# Dashboard
# ------------------------------------------------------------

DASHBOARD_BASE_URL=http://localhost:3000

# ------------------------------------------------------------
# n8n
# ------------------------------------------------------------

N8N_ENCRYPTION_KEY=replace_with_a_random_32_byte_key
N8N_INTERNAL_API_TOKEN=replace_with_random_internal_token

# Demo operator
DEMO_OPERATOR_EMAIL=operator@northstar.local
DEMO_OPERATOR_PASSWORD=
DEMO_OPERATOR_DISPLAY_NAME=NorthStar Demo Administrator
DEMO_OPERATOR_ROLE=ADMIN

SUPABASE_SERVICE_ROLE_KEY=